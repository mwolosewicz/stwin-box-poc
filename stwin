#!/usr/bin/env bash
# Single entry point to all the tools. Usage: ./stwin <command> [options]

set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON="$REPO_DIR/.venv/bin/python"

if [ ! -x "$PYTHON" ]; then
    echo "No environment. Run ./setup.sh first" >&2
    exit 1
fi

usage() {
    cat <<'EOF'
Tools for the STWIN.box PoC (FP-SNS-DATALOG2 over USB).

  ./stwin probe
        Prints the firmware, the sensor list, their state and settings.

  ./stwin prepare --sensor SENSOR [--sensor ...] [--odr HZ] [--fs RANGE]
        Prepares the board for mounting: enables the chosen sensors, disables
        the rest and writes the configuration to the SD card so it survives a
        reset. Also sets the board clock and shows how much data per hour the
        selected set will produce.

  ./stwin clock
        Reads the board clock and compares it with the computer clock. Worth
        checking before mounting the device, because acquisitions started from
        the USR button take their date from it.

  ./stwin record NAME [--sensor SENSOR] [--duration SECONDS] [--note TEXT]
        Records an acquisition into recordings/. Defaults to iis3dwb_acc, 10 s.
        Disables the other sensors so the streams do not get mixed.

  ./stwin analyze DIRECTORY [--rpm SPEED] [--fmax HZ]
        Computes the time series, spectrum and PSD. Writes spectrum.png into the
        directory. Passing --rpm adds markers at 1x, 2x, 3x of the rotational
        frequency.

  ./stwin compare DIR_A DIR_B [--rpm SPEED] [--fmax HZ]
        Overlays the spectra of two recordings and shows their ratio.
        For comparing a healthy state against a fault.

  ./stwin wifi status
  ./stwin wifi connect --ssid NAME [--password PASSWORD]
  ./stwin wifi disconnect
  ./stwin wifi ftp --user NAME [--password PASSWORD]
        Configuration of Wi-Fi and of the FTP server through which the board
        serves the contents of its SD card. Omitting --password triggers an
        interactive prompt.

  ./stwin ble [--seconds SECONDS] [--all]
        Checks whether the board advertises over Bluetooth and how strong the
        signal is. Useful before mounting: the Wi-Fi password has to be sent
        after every reset from a phone over BLE, so you need to know whether
        the signal reaches that far.

  ./stwin nanoedge DIRECTORY -sl WINDOW_LENGTH [-o OUT_DIR]
        Converts a recording into the NanoEdge AI Studio input format.

  ./stwin python [...]
        The raw interpreter from the environment, in case something needs
        checking by hand.
EOF
}

CMD="${1:-help}"
shift || true

case "$CMD" in
    probe)     exec "$PYTHON" "$REPO_DIR/scripts/probe.py" "$@" ;;
    prepare)   exec "$PYTHON" -u "$REPO_DIR/scripts/prepare.py" "$@" ;;
    clock)     exec "$PYTHON" -u "$REPO_DIR/scripts/clock.py" "$@" ;;
    record)    exec "$PYTHON" "$REPO_DIR/scripts/record.py" "$@" ;;
    analyze)   exec "$PYTHON" "$REPO_DIR/scripts/analyze.py" "$@" ;;
    compare)   exec "$PYTHON" "$REPO_DIR/scripts/compare.py" "$@" ;;
    wifi)      exec "$PYTHON" "$REPO_DIR/scripts/wifi.py" "$@" ;;
    ble)       exec "$PYTHON" -u "$REPO_DIR/scripts/ble.py" "$@" ;;
    nanoedge)
        SDK_DIR="$(cat "$REPO_DIR/.sdk_path")"
        exec "$PYTHON" "$SDK_DIR/stdatalog_examples/cli_applications/stdatalog_to_nanoedge.py" "$@"
        ;;
    python)    exec "$PYTHON" "$@" ;;
    help|-h|--help) usage ;;
    *)
        echo "Unknown command: $CMD" >&2
        echo "" >&2
        usage >&2
        exit 1
        ;;
esac
